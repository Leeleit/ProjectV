#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcSceneColor;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D dstBloom;

layout(push_constant) uniform PushConstants {
    vec4 params0; // x=threshold, y=softKnee, z=bloomIntensity, w=mipLevel
    vec4 params1;
    vec4 params2;
    vec4 params3;
} pushConstants;

vec3 Threshold(vec3 color)
{
    const float threshold = pushConstants.params0.x;
    const float softKnee = pushConstants.params0.y;
    const float brightness = max(color.r, max(color.g, color.b));
    const float soft = clamp((brightness - threshold + softKnee) / max(softKnee, 0.0001), 0.0, 1.0);
    const float contribution = soft * soft * (3.0 - 2.0 * soft);
    const float gain = max(brightness - threshold, 0.0) / max(brightness, 0.0001);
    return color * gain * contribution;
}

void main()
{
    const ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 dstSize = imageSize(dstBloom);
    if (any(greaterThanEqual(coord, dstSize))) {
        return;
    }

    const vec2 uv = (vec2(coord) + 0.5) / vec2(dstSize);
    const vec3 sceneColor = textureLod(srcSceneColor, uv, 0.0).rgb;
    const vec3 thresholded = Threshold(sceneColor);
    imageStore(dstBloom, coord, vec4(thresholded, 1.0));
}
