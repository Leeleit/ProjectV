#version 460

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

struct ChunkDescriptor {
    ivec4 chunkOrigin;
    uvec4 chunkExtentAndNonAir;
    uvec4 voxelDataInfo;
    uvec4 drawRanges;
};

struct DrawCommand {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};

struct PackedFace {
    uint localVoxelFace;
    uint chunkIndexMaterial;
    uint lightingData;
    uint packedExtents;
};

layout(set = 0, binding = 0, std430) buffer PackedChunkDescriptors {
    ChunkDescriptor chunkDescriptors[];
};

layout(set = 0, binding = 1, std430) readonly buffer PackedChunkVoxelPayload {
    uint chunkVoxelWords[];
};

layout(set = 0, binding = 2, std430) writeonly buffer PackedFacePayload {
    PackedFace packedFaces[];
};

layout(set = 0, binding = 3, std430) readonly buffer DirtyChunkIndexBuffer {
    uint dirtyChunkIndices[];
};

layout(set = 0, binding = 4, std430) buffer OpaqueIndirectCommands {
    DrawCommand opaqueCommands[];
};

layout(set = 0, binding = 5, std430) buffer TransparentIndirectCommands {
    DrawCommand transparentCommands[];
};

layout(set = 0, binding = 6, std430) buffer ShadowIndirectCommands {
    DrawCommand shadowCommands[];
};

layout(set = 0, binding = 7, std430) readonly buffer ChunkCullingParameters {
    vec4 cameraPositionAndMaxDistance;
    vec4 cameraForwardAndTanHalfVerticalFov;
    vec4 cameraRightAndTanHalfHorizontalFov;
    vec4 cameraUpAndNearPlane;
} chunkCulling;

layout(set = 0, binding = 8, std430) readonly buffer SceneLightingBuffer {
    vec4 skyColorAndFogDensity;
    vec4 horizonColorAndFogStart;
    vec4 groundColorAndFogMax;
    vec4 sunColorAndIntensity;
    vec4 sunDirectionAndWrap;
    vec4 postProcess;
    vec4 sunShadowParams;
    vec4 sunContactShadowParams;
    vec4 ambientOcclusionParams;
    mat4 sunShadowViewProjections[4];
    vec4 colorGrading;
    vec4 exposureControl;
    vec4 shadowCascadeDepthSplits;
    vec4 shadowCascadeBlendParams;
    vec4 localPointLightPositionAndRadius;
    vec4 localPointLightColorAndIntensity;
    vec4 localPointLightParams;
    vec4 taaParams;
    mat4 prevViewProjectionMatrix;
    vec4 taaHistoryParams;

    vec4 taaLayerHistoryParams;
} sceneLighting;

layout(push_constant) uniform PushConstants {
    ivec4 worldMinAndChunkSize;
    ivec4 worldMaxExclusiveAndChunkCount;
    uvec4 chunkGridAndTransparentFaceBase;
    uvec4 faceCapacities;
} pushConstants;

const ivec3 kNeighborOffsets[6] = ivec3[](
ivec3(1, 0, 0),
ivec3(-1, 0, 0),
ivec3(0, 1, 0),
ivec3(0, -1, 0),
ivec3(0, 0, 1),
ivec3(0, 0, -1)
);
const uint kSunShadowCascadeCount = 4u;


const uint kMaxChunkExtentForGreedy = 64u;

uint PackLocalVoxelFace(const uvec3 localVoxelCoord, const uint faceIndex) {
    return (localVoxelCoord.x & 0xFFu) |
    ((localVoxelCoord.y & 0xFFu) << 8u) |
    ((localVoxelCoord.z & 0xFFu) << 16u) |
    ((faceIndex & 0xFFu) << 24u);
}


uint PackQuadExtents(const uint width, const uint height) {
    return (width & 0xFFu) | ((height & 0xFFu) << 8u);
}

uint PackChunkIndexMaterial(const uint chunkIndex, const uint materialIndex) {
    return (chunkIndex & 0x00FFFFFFu) | ((materialIndex & 0xFFu) << 24u);
}

uint DecodeChunkVoxelMaterial(const ChunkDescriptor chunkDescriptor, const uvec3 localCoord) {
    const uint localIndex =
    localCoord.x +
    chunkDescriptor.chunkExtentAndNonAir.x *
    (localCoord.y + chunkDescriptor.chunkExtentAndNonAir.y * localCoord.z);
    if (localIndex >= chunkDescriptor.voxelDataInfo.y) {
        return 0u;
    }

    const uint wordIndex = chunkDescriptor.voxelDataInfo.x + localIndex / 4u;
    const uint shift = (localIndex & 3u) * 8u;
    return (chunkVoxelWords[wordIndex] >> shift) & 0xFFu;
}

uint ReadVoxelMaterial(const ivec3 worldPosition) {
    const ivec3 worldMin = pushConstants.worldMinAndChunkSize.xyz;
    const ivec3 worldMaxExclusive = pushConstants.worldMaxExclusiveAndChunkCount.xyz;
    if (worldPosition.x < worldMin.x || worldPosition.y < worldMin.y || worldPosition.z < worldMin.z ||
    worldPosition.x >= worldMaxExclusive.x ||
    worldPosition.y >= worldMaxExclusive.y ||
    worldPosition.z >= worldMaxExclusive.z) {
        return 0u;
    }

    const uint chunkSize = uint(pushConstants.worldMinAndChunkSize.w);
    const uvec3 chunkGrid = pushConstants.chunkGridAndTransparentFaceBase.xyz;
    const ivec3 localWorldPosition = worldPosition - worldMin;
    const uvec3 chunkCoord = uvec3(localWorldPosition) / chunkSize;
    const uint chunkIndex =
    chunkCoord.x +
    chunkGrid.x * (chunkCoord.y + chunkGrid.y * chunkCoord.z);
    const ChunkDescriptor chunkDescriptor = chunkDescriptors[chunkIndex];
    const uvec3 localChunkCoord = uvec3(worldPosition - chunkDescriptor.chunkOrigin.xyz);
    return DecodeChunkVoxelMaterial(chunkDescriptor, localChunkCoord);
}

bool ShouldEmitVoxelFace(const uint materialIndex, const uint neighborMaterialIndex) {
    if (materialIndex == 0u) {
        return false;
    }


    if (materialIndex >= 3u) {
        return neighborMaterialIndex == 0u || neighborMaterialIndex == 1u;
    }

    if (materialIndex == 2u) {
        return true;
    }

    return neighborMaterialIndex == 0u;
}

bool IsAmbientOccluder(const uint materialIndex) {
    if (materialIndex == 0u || materialIndex == 1u) {
        return false;
    }

    return true;
}

uint ReadAmbientOccluder(const ivec3 worldPosition) {
    return IsAmbientOccluder(ReadVoxelMaterial(worldPosition)) ? 1u : 0u;
}

void GetFaceCornerAmbientOffsets(
const uint faceIndex,
const uint cornerIndex,
out ivec3 sideOffsetA,
out ivec3 sideOffsetB,
out ivec3 diagonalOffset) {
    if (faceIndex == 0u) {
        sideOffsetA = cornerIndex == 1u || cornerIndex == 2u ? ivec3(0, 1, 0) : ivec3(0, -1, 0);
        sideOffsetB = cornerIndex >= 2u ? ivec3(0, 0, 1) : ivec3(0, 0, -1);
    } else if (faceIndex == 1u) {
        sideOffsetA = cornerIndex == 1u || cornerIndex == 2u ? ivec3(0, 1, 0) : ivec3(0, -1, 0);
        sideOffsetB = cornerIndex == 0u || cornerIndex == 1u ? ivec3(0, 0, 1) : ivec3(0, 0, -1);
    } else if (faceIndex == 2u) {
        sideOffsetA = cornerIndex >= 2u ? ivec3(1, 0, 0) : ivec3(-1, 0, 0);
        sideOffsetB = cornerIndex == 1u || cornerIndex == 2u ? ivec3(0, 0, 1) : ivec3(0, 0, -1);
    } else if (faceIndex == 3u) {
        sideOffsetA = cornerIndex >= 2u ? ivec3(1, 0, 0) : ivec3(-1, 0, 0);
        sideOffsetB = cornerIndex == 0u || cornerIndex == 3u ? ivec3(0, 0, 1) : ivec3(0, 0, -1);
    } else if (faceIndex == 4u) {
        sideOffsetA = cornerIndex <= 1u ? ivec3(1, 0, 0) : ivec3(-1, 0, 0);
        sideOffsetB = cornerIndex == 1u || cornerIndex == 2u ? ivec3(0, 1, 0) : ivec3(0, -1, 0);
    } else {
        sideOffsetA = cornerIndex >= 2u ? ivec3(1, 0, 0) : ivec3(-1, 0, 0);
        sideOffsetB = cornerIndex == 1u || cornerIndex == 2u ? ivec3(0, 1, 0) : ivec3(0, -1, 0);
    }

    diagonalOffset = sideOffsetA + sideOffsetB;
}

uint ComputeFaceCornerAmbientLevel(
const ivec3 worldVoxelPosition,
const uint faceIndex,
const uint cornerIndex) {
    ivec3 sideOffsetA = ivec3(0);
    ivec3 sideOffsetB = ivec3(0);
    ivec3 diagonalOffset = ivec3(0);
    GetFaceCornerAmbientOffsets(faceIndex, cornerIndex, sideOffsetA, sideOffsetB, diagonalOffset);

    const uint sideA = ReadAmbientOccluder(worldVoxelPosition + sideOffsetA);
    const uint sideB = ReadAmbientOccluder(worldVoxelPosition + sideOffsetB);
    if (sideA != 0u && sideB != 0u) {
        return 0u;
    }

    const uint diagonal = ReadAmbientOccluder(worldVoxelPosition + diagonalOffset);
    return 3u - min(sideA + sideB + diagonal, 3u);
}

uint ComputeFaceCornerPackedAO(const ivec3 worldVoxelPosition, const uint faceIndex) {
    return worldVoxelPosition.x * 0u + faceIndex * 0u;
}

bool IsChunkVisible(const ChunkDescriptor chunkDescriptor) {
    if (chunkDescriptor.chunkExtentAndNonAir.w == 0u) {
        return false;
    }

    const vec3 chunkHalfExtent = vec3(chunkDescriptor.chunkExtentAndNonAir.xyz) * 0.5;
    const vec3 chunkCenter = vec3(chunkDescriptor.chunkOrigin.xyz) + chunkHalfExtent;
    const vec3 toChunkCenter = chunkCenter - chunkCulling.cameraPositionAndMaxDistance.xyz;
    const vec3 cameraForward = chunkCulling.cameraForwardAndTanHalfVerticalFov.xyz;
    const vec3 cameraRight = chunkCulling.cameraRightAndTanHalfHorizontalFov.xyz;
    const vec3 cameraUp = chunkCulling.cameraUpAndNearPlane.xyz;
    const float tanHalfVerticalFov = max(chunkCulling.cameraForwardAndTanHalfVerticalFov.w, 0.0);
    const float tanHalfHorizontalFov = max(chunkCulling.cameraRightAndTanHalfHorizontalFov.w, 0.0);
    const float projectedRadiusAlongForward = dot(abs(cameraForward), chunkHalfExtent);
    const float chunkRadius = length(chunkHalfExtent);
    const float nearPlane = max(chunkCulling.cameraUpAndNearPlane.w, 0.0);
    const float forwardDistance = dot(toChunkCenter, cameraForward);
    if (forwardDistance + projectedRadiusAlongForward < nearPlane) {
        return false;
    }

    const float maxDistance = chunkCulling.cameraPositionAndMaxDistance.w;
    if (maxDistance > 0.0) {
        const float maxCenterDistance = maxDistance + chunkRadius;
        if (dot(toChunkCenter, toChunkCenter) > maxCenterDistance * maxCenterDistance) {
            return false;
        }
    }

    const vec3 leftPlane = cameraForward * tanHalfHorizontalFov + cameraRight;
    const vec3 rightPlane = cameraForward * tanHalfHorizontalFov - cameraRight;
    const vec3 bottomPlane = cameraForward * tanHalfVerticalFov + cameraUp;
    const vec3 topPlane = cameraForward * tanHalfVerticalFov - cameraUp;
    if (dot(toChunkCenter, leftPlane) + dot(abs(leftPlane), chunkHalfExtent) < 0.0) {
        return false;
    }
    if (dot(toChunkCenter, rightPlane) + dot(abs(rightPlane), chunkHalfExtent) < 0.0) {
        return false;
    }
    if (dot(toChunkCenter, bottomPlane) + dot(abs(bottomPlane), chunkHalfExtent) < 0.0) {
        return false;
    }
    if (dot(toChunkCenter, topPlane) + dot(abs(topPlane), chunkHalfExtent) < 0.0) {
        return false;
    }

    return true;
}

bool IsChunkInsideShadowCascade(const ChunkDescriptor chunkDescriptor, const uint cascadeIndex) {
    bool outsideLeft = true;
    bool outsideRight = true;
    bool outsideBottom = true;
    bool outsideTop = true;
    bool outsideNear = true;
    bool outsideFar = true;

    const vec3 chunkMin = vec3(chunkDescriptor.chunkOrigin.xyz);
    const vec3 chunkMax = chunkMin + vec3(chunkDescriptor.chunkExtentAndNonAir.xyz);
    for (uint cornerIndex = 0u; cornerIndex < 8u; ++cornerIndex) {
        const vec3 corner = vec3(
        (cornerIndex & 1u) != 0u ? chunkMax.x : chunkMin.x,
        (cornerIndex & 2u) != 0u ? chunkMax.y : chunkMin.y,
        (cornerIndex & 4u) != 0u ? chunkMax.z : chunkMin.z);
        const vec4 clipCorner = sceneLighting.sunShadowViewProjections[cascadeIndex] * vec4(corner, 1.0);
        outsideLeft = outsideLeft && clipCorner.x < -clipCorner.w;
        outsideRight = outsideRight && clipCorner.x > clipCorner.w;
        outsideBottom = outsideBottom && clipCorner.y < -clipCorner.w;
        outsideTop = outsideTop && clipCorner.y > clipCorner.w;
        outsideNear = outsideNear && clipCorner.z < 0.0;
        outsideFar = outsideFar && clipCorner.z > clipCorner.w;
        if (!outsideLeft &&
        !outsideRight &&
        !outsideBottom &&
        !outsideTop &&
        !outsideNear &&
        !outsideFar) {
            return true;
        }
    }

    return !(outsideLeft || outsideRight || outsideBottom || outsideTop || outsideNear || outsideFar);
}

void GreedyFacePass(
    const uint faceIndex,
    const uint axisN,
    const uint axisU,
    const uint axisV,
    const int signN,
    const ChunkDescriptor chunkDescriptor,
    const uint chunkIndex,
    const uint opaqueFirstFace,
    const uint transparentFirstFace,
    const uint maxChunkFaceCount,
    inout uint opaqueFaceCount,
    inout uint transparentFaceCount) {
    const uint extentN = chunkDescriptor.chunkExtentAndNonAir[axisN];
    const uint extentU = chunkDescriptor.chunkExtentAndNonAir[axisU];
    const uint extentV = chunkDescriptor.chunkExtentAndNonAir[axisV];

    const bool useGreedy = (extentU <= kMaxChunkExtentForGreedy) &&
    (extentV <= kMaxChunkExtentForGreedy);

    for (uint pN = 0u; pN < extentN; ++pN) {
        if (useGreedy) {

            uint visited[kMaxChunkExtentForGreedy];
            for (uint i = 0u; i < kMaxChunkExtentForGreedy; ++i) {
                visited[i] = 0u;
            }

            for (uint pV = 0u; pV < extentV; ++pV) {
                for (uint pU = 0u; pU < extentU; ++pU) {
                    if (((visited[pV] >> pU) & 1u) != 0u) {
                        continue;
                    }

                    uvec3 localVoxelCoord;
                    localVoxelCoord[axisN] = pN;
                    localVoxelCoord[axisU] = pU;
                    localVoxelCoord[axisV] = pV;
                    const uint cellMaterial = DecodeChunkVoxelMaterial(chunkDescriptor, localVoxelCoord);
                    if (cellMaterial == 0u) {
                        continue;
                    }


                    ivec3 worldVoxelPosition = ivec3(chunkDescriptor.chunkOrigin.xyz) + ivec3(localVoxelCoord);
                    ivec3 neighborPosition = worldVoxelPosition;
                    neighborPosition[axisN] += signN;
                    const uint neighborMaterial = ReadVoxelMaterial(neighborPosition);
                    if (!ShouldEmitVoxelFace(cellMaterial, neighborMaterial)) {
                        continue;
                    }

                    uint W = 0u;
                    while (pU + W < extentU) {
                        if (((visited[pV] >> (pU + W)) & 1u) != 0u) {
                            break;
                        }
                        uvec3 testCoord = localVoxelCoord;
                        testCoord[axisU] = pU + W;
                        const uint testMaterial = DecodeChunkVoxelMaterial(chunkDescriptor, testCoord);
                        if (testMaterial != cellMaterial) {
                            break;
                        }
                        ivec3 testNeighbor = worldVoxelPosition;
                        testNeighbor[axisN] += signN;
                        testNeighbor[axisU] += int(W);
                        const uint testNeighborMaterial = ReadVoxelMaterial(testNeighbor);
                        if (!ShouldEmitVoxelFace(testMaterial, testNeighborMaterial)) {
                            break;
                        }
                        ++W;
                    }
                    if (W == 0u) {
                        continue;
                    }

                    uint H = 1u;
                    while (pV + H < extentV) {
                        bool rowValid = true;
                        for (uint wi = 0u; wi < W; ++wi) {
                            if (((visited[pV + H] >> (pU + wi)) & 1u) != 0u) {
                                rowValid = false;
                                break;
                            }
                            uvec3 testCoord = localVoxelCoord;
                            testCoord[axisU] = pU + wi;
                            testCoord[axisV] = pV + H;
                            const uint testMaterial = DecodeChunkVoxelMaterial(chunkDescriptor, testCoord);
                            if (testMaterial != cellMaterial) {
                                rowValid = false;
                                break;
                            }
                            ivec3 testNeighbor = worldVoxelPosition;
                            testNeighbor[axisN] += signN;
                            testNeighbor[axisU] += int(wi);
                            testNeighbor[axisV] += int(H);
                            const uint testNeighborMaterial = ReadVoxelMaterial(testNeighbor);
                            if (!ShouldEmitVoxelFace(testMaterial, testNeighborMaterial)) {
                                rowValid = false;
                                break;
                            }
                        }
                        if (!rowValid) {
                            break;
                        }
                        ++H;
                    }

                    const PackedFace packedFace = PackedFace(
                    PackLocalVoxelFace(localVoxelCoord, faceIndex),
                    PackChunkIndexMaterial(chunkIndex, cellMaterial),
                    0u, // lightingData no-op (per-vertex AO disabled)
                    PackQuadExtents(W, H));

                    if (cellMaterial == 1u) {
                        if (transparentFaceCount < maxChunkFaceCount) {
                            packedFaces[transparentFirstFace + transparentFaceCount] = packedFace;
                            ++transparentFaceCount;
                        }
                    } else {
                        if (opaqueFaceCount < maxChunkFaceCount) {
                            packedFaces[opaqueFirstFace + opaqueFaceCount] = packedFace;
                            ++opaqueFaceCount;
                        }
                    }

                    const uint visitedMask = ((1u << W) - 1u) << pU;
                    for (uint v = 0u; v < H; ++v) {
                        visited[pV + v] |= visitedMask;
                    }
                }
            }
        } else {

            for (uint pV = 0u; pV < extentV; ++pV) {
                for (uint pU = 0u; pU < extentU; ++pU) {
                    uvec3 localVoxelCoord;
                    localVoxelCoord[axisN] = pN;
                    localVoxelCoord[axisU] = pU;
                    localVoxelCoord[axisV] = pV;
                    const uint cellMaterial = DecodeChunkVoxelMaterial(chunkDescriptor, localVoxelCoord);
                    if (cellMaterial == 0u) {
                        continue;
                    }
                    ivec3 worldVoxelPosition = ivec3(chunkDescriptor.chunkOrigin.xyz) + ivec3(localVoxelCoord);
                    ivec3 neighborPosition = worldVoxelPosition;
                    neighborPosition[axisN] += signN;
                    const uint neighborMaterial = ReadVoxelMaterial(neighborPosition);
                    if (!ShouldEmitVoxelFace(cellMaterial, neighborMaterial)) {
                        continue;
                    }
                    const PackedFace packedFace = PackedFace(
                    PackLocalVoxelFace(localVoxelCoord, faceIndex),
                    PackChunkIndexMaterial(chunkIndex, cellMaterial),
                    0u,
                    PackQuadExtents(1u, 1u));
                    if (cellMaterial == 1u) {
                        if (transparentFaceCount < maxChunkFaceCount) {
                            packedFaces[transparentFirstFace + transparentFaceCount] = packedFace;
                            ++transparentFaceCount;
                        }
                    } else {
                        if (opaqueFaceCount < maxChunkFaceCount) {
                            packedFaces[opaqueFirstFace + opaqueFaceCount] = packedFace;
                            ++opaqueFaceCount;
                        }
                    }
                }
            }
        }
    }
}

void main() {
    const uint dirtyChunkListIndex = gl_GlobalInvocationID.x;
    if (dirtyChunkListIndex >= pushConstants.faceCapacities.z) {
        return;
    }
    const uint chunkIndex = dirtyChunkIndices[dirtyChunkListIndex];
    if (chunkIndex >= uint(pushConstants.worldMaxExclusiveAndChunkCount.w)) {
        return;
    }

    ChunkDescriptor chunkDescriptor = chunkDescriptors[chunkIndex];
    const uint opaqueFirstFace = chunkDescriptor.drawRanges.x;
    const uint transparentFirstFace = chunkDescriptor.drawRanges.z;
    const uint maxChunkFaceCount = chunkDescriptor.voxelDataInfo.y * 6u;
    const bool chunkVisible = IsChunkVisible(chunkDescriptor);
    if (chunkDescriptor.chunkExtentAndNonAir.w == 0u) {
        chunkDescriptors[chunkIndex].drawRanges.y = 0u;
        chunkDescriptors[chunkIndex].drawRanges.w = 0u;
        opaqueCommands[chunkIndex] = DrawCommand(6u, 0u, 0u, opaqueFirstFace);
        transparentCommands[chunkIndex] = DrawCommand(6u, 0u, 0u, transparentFirstFace);
        const uint chunkCount = uint(pushConstants.worldMaxExclusiveAndChunkCount.w);
        for (uint cascadeIndex = 0u; cascadeIndex < kSunShadowCascadeCount; ++cascadeIndex) {
            shadowCommands[cascadeIndex * chunkCount + chunkIndex] = DrawCommand(6u, 0u, 0u, opaqueFirstFace);
        }
        return;
    }

    uint opaqueFaceCount = 0u;
    uint transparentFaceCount = 0u;


    GreedyFacePass(0u, 0u, 1u, 2u, 1,
    chunkDescriptor, chunkIndex,
    opaqueFirstFace, transparentFirstFace, maxChunkFaceCount,
    opaqueFaceCount, transparentFaceCount);
    GreedyFacePass(1u, 0u, 1u, 2u, -1,
    chunkDescriptor, chunkIndex,
    opaqueFirstFace, transparentFirstFace, maxChunkFaceCount,
    opaqueFaceCount, transparentFaceCount);
    GreedyFacePass(2u, 1u, 0u, 2u, 1,
    chunkDescriptor, chunkIndex,
    opaqueFirstFace, transparentFirstFace, maxChunkFaceCount,
    opaqueFaceCount, transparentFaceCount);
    GreedyFacePass(3u, 1u, 0u, 2u, -1,
    chunkDescriptor, chunkIndex,
    opaqueFirstFace, transparentFirstFace, maxChunkFaceCount,
    opaqueFaceCount, transparentFaceCount);
    GreedyFacePass(4u, 2u, 0u, 1u, 1,
    chunkDescriptor, chunkIndex,
    opaqueFirstFace, transparentFirstFace, maxChunkFaceCount,
    opaqueFaceCount, transparentFaceCount);
    GreedyFacePass(5u, 2u, 0u, 1u, -1,
    chunkDescriptor, chunkIndex,
    opaqueFirstFace, transparentFirstFace, maxChunkFaceCount,
    opaqueFaceCount, transparentFaceCount);

    chunkDescriptors[chunkIndex].drawRanges.y = opaqueFaceCount;
    chunkDescriptors[chunkIndex].drawRanges.w = transparentFaceCount;
    opaqueCommands[chunkIndex] = DrawCommand(6u, chunkVisible ? opaqueFaceCount : 0u, 0u, opaqueFirstFace);
    transparentCommands[chunkIndex] = DrawCommand(6u, chunkVisible ? transparentFaceCount : 0u, 0u, transparentFirstFace);
    const uint chunkCount = uint(pushConstants.worldMaxExclusiveAndChunkCount.w);
    for (uint cascadeIndex = 0u; cascadeIndex < kSunShadowCascadeCount; ++cascadeIndex) {
        const bool shadowVisible = IsChunkInsideShadowCascade(chunkDescriptor, cascadeIndex);
        shadowCommands[cascadeIndex * chunkCount + chunkIndex] =
        DrawCommand(6u, shadowVisible ? opaqueFaceCount : 0u, 0u, opaqueFirstFace);
    }
}
