#version 460
#extension GL_EXT_mesh_shader : enable

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 256, max_primitives = 256) out;

struct PackedFace {
    uint localVoxelFace;
    uint chunkIndexMaterial;
    uint lightingData;
    uint packedExtents;
};

struct ChunkDescriptor {
    ivec4 chunkOrigin;
    uvec4 chunkExtentAndNonAir;
    uvec4 voxelDataInfo;
    uvec4 drawRanges;
};

struct FaceCluster {
    uint faceOffset;
    uint faceCount;
    uint chunkIndex;
    uint flags;
    vec4 aabbCenterHalfExtent;
    vec4 aabbHalfExtentXYZ;
};

layout(set = 0, binding = 0, std430) readonly buffer PackedFacePayload {
    PackedFace packedFaces[];
};

layout(set = 0, binding = 1, std430) readonly buffer PackedChunkDescriptors {
    ChunkDescriptor chunkDescriptors[];
};

layout(set = 1, binding = 0, std430) readonly buffer FaceClusterBuffer {
    FaceCluster faceClusters[];
};

layout(set = 1, binding = 1, std430) readonly buffer VisibleClusterIdBuffer {
    uint visibleClusterIds[];
};

layout(set = 1, binding = 2, std430) readonly buffer FaceClusterCount {
    uint clusterCount;
};

layout(set = 1, binding = 3, std430) readonly buffer MeshDrawIndirect {
    uint groupCountX;
    uint groupCountY;
    uint groupCountZ;
};

layout(location = 0) out vec3 outNormal[];
layout(location = 1) out vec3 outWorldPosition[];
layout(location = 2) flat out uint outMaterialIndex[];
layout(location = 3) out float outAmbientVisibility[];
layout(location = 4) out vec2 outQuadUV[];

layout(push_constant) uniform PushConstants {
    mat4 viewProjection;
    vec4 cameraPosition;
    vec4 cameraForward;
    ivec4 worldMinAndChunkSize;
    uvec4 chunkGridAndFlags;
} pushConstants;

const uint kMeshMaxFaces = 64u;

vec3 DecodeFaceNormal(const uint faceIndex) {
    switch (faceIndex) {
        case 0u: return vec3(1.0, 0.0, 0.0);
        case 1u: return vec3(-1.0, 0.0, 0.0);
        case 2u: return vec3(0.0, 1.0, 0.0);
        case 3u: return vec3(0.0, -1.0, 0.0);
        case 4u: return vec3(0.0, 0.0, 1.0);
        default: return vec3(0.0, 0.0, -1.0);
    }
}

uvec3 GetFaceCornerOffset(const uint faceIndex, const uint cornerIndex) {
    switch (faceIndex) {
        case 0u:
            return cornerIndex == 0u ? uvec3(1u, 0u, 0u) :
                   cornerIndex == 1u ? uvec3(1u, 1u, 0u) :
                   cornerIndex == 2u ? uvec3(1u, 1u, 1u) : uvec3(1u, 0u, 1u);
        case 1u:
            return cornerIndex == 0u ? uvec3(0u, 0u, 1u) :
                   cornerIndex == 1u ? uvec3(0u, 1u, 1u) :
                   cornerIndex == 2u ? uvec3(0u, 1u, 0u) : uvec3(0u, 0u, 0u);
        case 2u:
            return cornerIndex == 0u ? uvec3(0u, 1u, 0u) :
                   cornerIndex == 1u ? uvec3(0u, 1u, 1u) :
                   cornerIndex == 2u ? uvec3(1u, 1u, 1u) : uvec3(1u, 1u, 0u);
        case 3u:
            return cornerIndex == 0u ? uvec3(0u, 0u, 1u) :
                   cornerIndex == 1u ? uvec3(0u, 0u, 0u) :
                   cornerIndex == 2u ? uvec3(1u, 0u, 0u) : uvec3(1u, 0u, 1u);
        case 4u:
            return cornerIndex == 0u ? uvec3(1u, 0u, 1u) :
                   cornerIndex == 1u ? uvec3(1u, 1u, 1u) :
                   cornerIndex == 2u ? uvec3(0u, 1u, 1u) : uvec3(0u, 0u, 1u);
        default:
            return cornerIndex == 0u ? uvec3(0u, 0u, 0u) :
                   cornerIndex == 1u ? uvec3(0u, 1u, 0u) :
                   cornerIndex == 2u ? uvec3(1u, 1u, 0u) : uvec3(1u, 0u, 0u);
    }
}

uvec3 ApplyGreedyScale(const uint faceIndex, const uvec3 unitOffset, const uvec2 quadExtents) {
    if (faceIndex == 0u || faceIndex == 1u) {
        return uvec3(unitOffset.x, unitOffset.y * quadExtents.x, unitOffset.z * quadExtents.y);
    } else if (faceIndex == 2u || faceIndex == 3u) {
        return uvec3(unitOffset.x * quadExtents.x, unitOffset.y, unitOffset.z * quadExtents.y);
    }
    return uvec3(unitOffset.x * quadExtents.x, unitOffset.y * quadExtents.y, unitOffset.z);
}

void main()
{
    const uint taskIndex = gl_WorkGroupID.x;
    if (taskIndex >= groupCountX) {
        SetMeshOutputsEXT(0u, 0u);
        return;
    }

    const uint clusterIndex = visibleClusterIds[taskIndex];
    const FaceCluster cluster = faceClusters[clusterIndex];
    const uint faceCount = min(cluster.faceCount, kMeshMaxFaces);
    if (faceCount == 0u) {
        SetMeshOutputsEXT(0u, 0u);
        return;
    }

    SetMeshOutputsEXT(faceCount * 4u, faceCount * 2u);

    for (uint faceLocal = 0u; faceLocal < faceCount; ++faceLocal) {
        const PackedFace packedFace = packedFaces[cluster.faceOffset + faceLocal];
        const uint localVoxelFace = packedFace.localVoxelFace;
        const uint chunkIndexMaterial = packedFace.chunkIndexMaterial;
        const uint faceIndex = (localVoxelFace >> 24u) & 0xFFu;
        const uint materialIndex = (chunkIndexMaterial >> 24u) & 0xFFu;
        const uint chunkIndex = chunkIndexMaterial & 0x00FFFFFFu;
        const uvec3 localVoxelCoord = uvec3(
            localVoxelFace & 0xFFu,
            (localVoxelFace >> 8u) & 0xFFu,
            (localVoxelFace >> 16u) & 0xFFu);
        const uvec2 quadExtents = uvec2(
            packedFace.packedExtents & 0xFFu,
            (packedFace.packedExtents >> 8u) & 0xFFu);
        const vec3 normal = DecodeFaceNormal(faceIndex);
        const vec3 chunkOrigin = vec3(chunkDescriptors[chunkIndex].chunkOrigin.xyz);
        const uint baseVertex = faceLocal * 4u;
        const uint basePrim = faceLocal * 2u;

        for (uint corner = 0u; corner < 4u; ++corner) {
            const uvec3 unitOffset = GetFaceCornerOffset(faceIndex, corner);
            const uvec3 scaledOffset = ApplyGreedyScale(faceIndex, unitOffset, quadExtents);
            const vec3 worldPosition = chunkOrigin + vec3(localVoxelCoord + scaledOffset);
            gl_MeshVerticesEXT[baseVertex + corner].gl_Position =
                pushConstants.viewProjection * vec4(worldPosition, 1.0);
            outNormal[baseVertex + corner] = normal;
            outWorldPosition[baseVertex + corner] = worldPosition;
            outMaterialIndex[baseVertex + corner] = materialIndex;
            outAmbientVisibility[baseVertex + corner] = 1.0;
            outQuadUV[baseVertex + corner] =
                vec2[4](vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 1.0))[corner];
        }

        gl_PrimitiveTriangleIndicesEXT[basePrim] = uvec3(baseVertex + 0u, baseVertex + 1u, baseVertex + 2u);
        gl_PrimitiveTriangleIndicesEXT[basePrim + 1u] = uvec3(baseVertex + 0u, baseVertex + 2u, baseVertex + 3u);
    }
}
