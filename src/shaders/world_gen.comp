int Permute(int x, int seed) {
    return PERMUTATION[(x + seed) & 0xFF];
}

const float kR2 = (2.0 / 3.0);
const float kR3 = (3.0 / 4.0);

const float kStretch3D = -1.0 / 3.0;
const float kSquish3D = 1.0 / 3.0;

vec3 kGradients3D[22] = vec3[](
    vec3(-1.0,  0.0,  0.0), vec3( 1.0,  0.0,  0.0),
    vec3( 0.0, -1.0,  0.0), vec3( 0.0,  1.0,  0.0),
    vec3( 0.0,  0.0, -1.0), vec3( 0.0,  0.0,  1.0),
    vec3(-0.5774,  0.5774, -0.5774), vec3( 0.5774, -0.5774,  0.5774),
    vec3( 0.5774,  0.5774, -0.5774), vec3(-0.5774, -0.5774,  0.5774),
    vec3(-0.5774,  0.5774,  0.5774), vec3( 0.5774, -0.5774, -0.5774),
    vec3( 0.5774, -0.5774, -0.5774), vec3(-0.5774,  0.5774,  0.5774),
    vec3( 0.5774,  0.5774,  0.5774), vec3(-0.5774, -0.5774, -0.5774),
    vec3( 0.0, -0.7071, -0.7071), vec3( 0.0,  0.7071,  0.7071),
    vec3(-0.7071,  0.0, -0.7071), vec3( 0.7071,  0.0,  0.7071),
    vec3(-0.7071, -0.7071,  0.0), vec3( 0.7071,  0.7071,  0.0)
);

float OpenSimplex2SNoise3(vec3 point, int seed) {
    const vec3 rotateOffset = vec3(31.416, 47.853, 123.45);
    const float normalizer = 14.0;
    vec3 rotatedPoint = point + rotateOffset;

    vec3 stretched = vec3(
        rotatedPoint.x - (rotatedPoint.y + rotatedPoint.z) * kStretch3D,
        rotatedPoint.y - (rotatedPoint.x + rotatedPoint.z) * kStretch3D,
        rotatedPoint.z - (rotatedPoint.x + rotatedPoint.y) * kStretch3D
    );

    const float xb = floor(stretched.x);
    const float yb = floor(stretched.y);
    const float zb = floor(stretched.z);
    const float xi = stretched.x - xb;
    const float yi = stretched.y - yb;
    const float zi = stretched.z - zb;

    vec3 unstretched = vec3(
        stretched.x + (yi + zi) * kSquish3D,
        stretched.y + (xi + zi) * kSquish3D,
        stretched.z + (xi + yi) * kSquish3D
    );

    int xbf = int(xb);
    int ybf = int(yb);
    int zbf = int(zb);

    const float PRIME_X = 0.0;
    const float PRIME_Y = 127.1;
    const float PRIME_Z = 311.7;

    const int xc = xbf + int(ceil(xi));
    const int yc = ybf + int(ceil(yi));
    const int zc = zbf + int(ceil(zi));

    const int xMinusXPrime = xbf;
    const int yMinusYPrime = ybf + Permute(xbf, seed);
    const int zMinusZPrime = zbf + Permute(xbf + Permute(ybf, seed), seed);

    float value = 0.0;

    const float falloffValue = 0.5;

    if (xi < 0.5) {
        const vec3 c0 = unstretched - vec3(0.0, 0.0, 0.0);
        const int gi0 = (Permute(zMinusZPrime + int(PRIME_Z), seed) & 0x0F) * 3;
        value += dot(c0, kGradients3D[gi0]) * exp(-2.5 * dot(c0, c0));
    }
    if (yi < 0.5) {
        const vec3 c1 = unstretched - vec3(1.0, 0.0, 0.0);
        const int gi1 = (Permute(xMinusXPrime + Permute(zMinusZPrime + int(PRIME_Z), seed), seed) & 0x0F) * 3;
        value += dot(c1, kGradients3D[gi1]) * exp(-2.5 * dot(c1, c1));
    }
    if (zi < 0.5) {
        const vec3 c2 = unstretched - vec3(0.0, 1.0, 0.0);
        const int gi2 = (Permute(yMinusYPrime + Permute(zMinusZPrime + int(PRIME_Z), seed), seed) & 0x0F) * 3;
        value += dot(c2, kGradients3D[gi2]) * exp(-2.5 * dot(c2, c2));
    }

    return value / normalizer;
}

float Fbm3(vec3 point, int octaves, float persistence, int seed) {
    float total = 0.0;
    float amplitude = 1.0;
    float frequency = 1.0;
    float maxValue = 0.0;
    for (int i = 0; i < octaves; ++i) {
        total += OpenSimplex2SNoise3(point * frequency, seed + i) * amplitude;
        maxValue += amplitude;
        amplitude *= persistence;
        frequency *= 2.0;
    }
    return total / maxValue;
}

void main() {
    const uint globalIndex = gl_GlobalInvocationID.z * gl_NumWorkGroups.y * gl_NumWorkGroups.x * gl_WorkGroupSize.z * gl_WorkGroupSize.y * gl_WorkGroupSize.x
                           + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.z * gl_WorkGroupSize.y * gl_WorkGroupSize.x
                           + gl_GlobalInvocationID.x;
    if (globalIndex >= pushConstants.chunkCountAndFlags.x) {
        return;
    }

    const uint chunkIndex = globalIndex;
    const int chunkSize = pushConstants.chunkOriginAndChunkSize.w;
    const ivec3 chunkOrigin = ivec3(pushConstants.chunkOriginAndChunkSize.xyz);
    const float frequency = pushConstants.noiseParams.x;
    const float threshold = pushConstants.noiseParams.y;
    const int octaves = int(pushConstants.noiseParams.z);
    const int seed = int(pushConstants.seed);

    for (uint voxelIndex = 0u; voxelIndex < uint(chunkSize * chunkSize * chunkSize); ++voxelIndex) {
        const uint lx = voxelIndex % uint(chunkSize);
        const uint ly = (voxelIndex / uint(chunkSize)) % uint(chunkSize);
        const uint lz = voxelIndex / uint(chunkSize * chunkSize);
        const vec3 worldPosition = vec3(chunkOrigin + ivec3(int(lx), int(ly), int(lz)));
        const float noiseValue = Fbm3(worldPosition * frequency, octaves, kFbmPersistence, seed);
        const uint material = (noiseValue > threshold) ? 3u : 0u;
        const uint cellIndex = chunkIndex * uint(chunkSize * chunkSize * chunkSize) + voxelIndex;
        voxels[cellIndex] = material;
    }
}
