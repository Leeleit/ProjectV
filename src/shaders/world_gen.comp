//
// Per `2026-06-21-gpu-procedural-noise-compute-kernels` verdict=mixed:
//   - All 5 noise kernels within 2.9% mean on RTX 3060 Ti Ampere (chunkSize=8 dispatch)
//   - memory-bound (SSBO write = 65.6% of 448 GB/s peak = 65.6% efficiency)
//   - per-eval 13 ns, per-chunk 6.6 us (8x Stage 4.1 budget headroom single octave)
//   - Algorithm choice not meaningful for perf on chunkSize=8
//   - Recommendation: use OpenSimplex2 3D-S NOT because fastest but because
//     license=CC0 + no axis artifacts + analytic derivatives + stable cold-cache.
//
// Stage 4.1 DoD budget (TODO.md §4.1): 50 us/chunk @ chunkSize=8 chunkSize.
// 8x headroom single octave, 1.9x FBM 4 octaves, 0.63x multi-channel FBM 4 octaves x 3 channels.

#version 460
#extension GL_EXT_shader_float_controls2 : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) writeonly buffer WorldGenVoxels {
    uint voxels[];
};

layout(push_constant) uniform WorldGenPushConstants {
    ivec4 chunkOriginAndChunkSize;
    uvec4 chunkCountAndFlags;
    vec4 noiseParams;
    uint seed;
    uint reserved0;
    uint reserved1;
    uint reserved2;
} pushConstants;

const float kFbmPersistence = 0.5;
const int kFbmOctaves = 4;

const int kPermutationSize = 256;

