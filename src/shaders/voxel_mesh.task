#version 460
#extension GL_EXT_mesh_shader : enable

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

struct ChunkDescriptor {
    ivec4 chunkOrigin;
    uvec4 chunkExtentAndNonAir;
    uvec4 voxelDataInfo;
    uvec4 drawRanges;
};

layout(set = 0, binding = 0, std430) readonly buffer PackedChunkDescriptors {
    ChunkDescriptor chunkDescriptors[];
};

struct MeshTaskPayload {
    uint chunkIndex;
    vec3 chunkOrigin;
    float extent;
};

taskPayloadSharedEXT MeshTaskPayload payload;

layout(push_constant) uniform TaskPushConstants {
    mat4 viewProjection;
    uvec4 chunkCountAndFlags;
    vec4 frustumPlanes[6];
} pushConstants;

bool AabbInsideFrustum(const vec3 origin, const float halfExtent, const vec4 planes[6])
{
    for (int i = 0; i < 6; ++i) {
        const vec3 absNormal = abs(planes[i].xyz);
        const float r = halfExtent * (absNormal.x + absNormal.y + absNormal.z);
        if (dot(planes[i].xyz, origin) + planes[i].w + r < 0.0) {
            return false;
        }
    }
    return true;
}

void main()
{
    const uint chunkIndex = gl_WorkGroupID.x;
    if (chunkIndex >= pushConstants.chunkCountAndFlags.x) {
        EmitMeshTasksEXT(0u, 1u, 1u);
        return;
    }

    const ChunkDescriptor chunk = chunkDescriptors[chunkIndex];
    const vec3 origin = vec3(chunk.chunkOrigin.xyz);
    const float halfExtent = 0.5 * float(chunk.chunkExtentAndNonAir.x);

    if (!AabbInsideFrustum(origin, halfExtent, pushConstants.frustumPlanes)) {
        EmitMeshTasksEXT(0u, 1u, 1u);
        return;
    }

    payload.chunkIndex = chunkIndex;
    payload.chunkOrigin = origin;
    payload.extent = float(chunk.chunkExtentAndNonAir.x);
    EmitMeshTasksEXT(1u, 1u, 1u);
}
