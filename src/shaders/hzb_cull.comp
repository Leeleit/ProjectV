#version 460

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct ChunkAabb {
    vec4 centerAndHalfExtent;
    vec4 originAndPadding;
};

layout(set = 0, binding = 0, std430) readonly buffer ChunkAabbBuffer {
    ChunkAabb chunkAabbs[];
};

layout(set = 0, binding = 1, std430) writeonly buffer VisibilityMask {
    uint visibilityWords[];
};

layout(set = 0, binding = 2) uniform texture2D hizTexture;
layout(set = 0, binding = 3) uniform sampler hizSampler;

layout(set = 0, binding = 4, std430) buffer VisibleCount {
    uint visibleCount;
};

layout(set = 0, binding = 5, std430) readonly buffer PerChunkMip {
    // Kept for descriptor layout compatibility; mip is selected in-shader from footprint.
    uint perChunkMipAndBlendWidth[];
};

layout(push_constant) uniform CullPushConstants {
    mat4 viewProjection;
    uvec4 hizExtentAndMipCount; // xy=baseExtent, z=chunkCount, w=maxMip inclusive
    vec4 depthUnpackParams;
} pushConstants;

const uint kBitsPerWord = 32u;

bool AabbVisibleHiZ(const ChunkAabb aabb, const mat4 viewProjection, const ivec2 hizBaseExtent, const int maxMip)
{
    const vec3 center = aabb.centerAndHalfExtent.xyz;
    const vec3 anisotropicHalf = aabb.originAndPadding.xyz;
    const vec3 halfExtent = (aabb.originAndPadding.w > 0.0)
        ? anisotropicHalf
        : vec3(aabb.centerAndHalfExtent.w);

    vec3 ndcMin = vec3( 1.0);
    vec3 ndcMax = vec3(-1.0);
    bool anyValid = false;
    for (int cornerX = 0; cornerX < 2; ++cornerX) {
        for (int cornerY = 0; cornerY < 2; ++cornerY) {
            for (int cornerZ = 0; cornerZ < 2; ++cornerZ) {
                const vec3 corner = center + halfExtent * vec3(
                    cornerX == 0 ? -1.0 : 1.0,
                    cornerY == 0 ? -1.0 : 1.0,
                    cornerZ == 0 ? -1.0 : 1.0);
                const vec4 clip = viewProjection * vec4(corner, 1.0);
                if (clip.w <= 1.0e-4) {
                    return true; // crosses near plane — keep
                }
                const vec3 ndc = clip.xyz / clip.w;
                ndcMin = min(ndcMin, ndc);
                ndcMax = max(ndcMax, ndc);
                anyValid = true;
            }
        }
    }
    if (!anyValid) {
        return true;
    }

    // Outside clip volume: keep (frustum cull lives elsewhere; avoid false kills).
    if (ndcMax.x < -1.0 || ndcMin.x > 1.0 ||
        ndcMax.y < -1.0 || ndcMin.y > 1.0 ||
        ndcMax.z <  0.0 || ndcMin.z > 1.0) {
        return true;
    }

    const float uMin = clamp(ndcMin.x * 0.5 + 0.5, 0.0, 1.0);
    const float uMax = clamp(ndcMax.x * 0.5 + 0.5, 0.0, 1.0);
    const float vMin = clamp(ndcMin.y * 0.5 + 0.5, 0.0, 1.0);
    const float vMax = clamp(ndcMax.y * 0.5 + 0.5, 0.0, 1.0);

    const float sizeX = max((uMax - uMin) * float(hizBaseExtent.x), 1.0);
    const float sizeY = max((vMax - vMin) * float(hizBaseExtent.y), 1.0);
    const float footprint = max(sizeX, sizeY);
    // floor(log2(extent)) — same as ComputePerChunkMipLevelCpu.
    int mipLevel = int(floor(log2(footprint)));
    mipLevel = clamp(mipLevel, 0, max(maxMip, 0));

    const int mipWidth = max(1, hizBaseExtent.x >> mipLevel);
    const int mipHeight = max(1, hizBaseExtent.y >> mipLevel);

    const int pixMinX = clamp(int(floor(uMin * float(mipWidth))), 0, mipWidth - 1);
    const int pixMinY = clamp(int(floor(vMin * float(mipHeight))), 0, mipHeight - 1);
    const int pixMaxX = clamp(int(floor(uMax * float(mipWidth))), 0, mipWidth - 1);
    const int pixMaxY = clamp(int(floor(vMax * float(mipHeight))), 0, mipHeight - 1);

    const float d00 = texelFetch(sampler2D(hizTexture, hizSampler), ivec2(pixMinX, pixMinY), mipLevel).r;
    const float d10 = texelFetch(sampler2D(hizTexture, hizSampler), ivec2(pixMaxX, pixMinY), mipLevel).r;
    const float d01 = texelFetch(sampler2D(hizTexture, hizSampler), ivec2(pixMinX, pixMaxY), mipLevel).r;
    const float d11 = texelFetch(sampler2D(hizTexture, hizSampler), ivec2(pixMaxX, pixMaxY), mipLevel).r;
    const float farthestDepth = max(max(d00, d10), max(d01, d11)); // Normal-Z max pyramid keeps partial AABB coverage visible.

    const float nearestDepth = clamp(ndcMin.z, 0.0, 1.0);
    return nearestDepth <= farthestDepth + 1.0e-4;
}

void main()
{
    const uint chunkIndex = gl_GlobalInvocationID.x;
    const uint wordIndex = chunkIndex / kBitsPerWord;
    const uint bitIndex = chunkIndex % kBitsPerWord;

    if (chunkIndex >= pushConstants.hizExtentAndMipCount.z) {
        return;
    }

    const int maxMip = int(pushConstants.hizExtentAndMipCount.w);
    const ivec2 hizBaseExtent = ivec2(pushConstants.hizExtentAndMipCount.x, pushConstants.hizExtentAndMipCount.y);

    const bool visible = AabbVisibleHiZ(
        chunkAabbs[chunkIndex],
        pushConstants.viewProjection,
        hizBaseExtent,
        maxMip);

    if (visible) {
        atomicOr(visibilityWords[wordIndex], 1u << bitIndex);
        atomicAdd(visibleCount, 1u);
    }
}
