#version 460

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct FaceCluster {
    uint faceOffset;
    uint faceCount;
    uint chunkIndex;
    uint flags;
    vec4 aabbCenterHalfExtent;
    vec4 aabbHalfExtentXYZ;
};

layout(set = 0, binding = 0, std430) readonly buffer FaceClusterBuffer {
    FaceCluster faceClusters[];
};

layout(set = 0, binding = 1, std430) writeonly buffer VisibleClusterIdBuffer {
    uint visibleClusterIds[];
};

layout(set = 0, binding = 2, std430) readonly buffer FaceClusterCount {
    uint clusterCount;
};

layout(set = 0, binding = 3, std430) buffer MeshDrawIndirect {
    uint groupCountX;
    uint groupCountY;
    uint groupCountZ;
};

layout(set = 0, binding = 4, std430) readonly buffer VisibilityMask {
    uint visibilityWords[];
};

layout(set = 0, binding = 5, std430) readonly buffer PreviousVisibilityMask {
    uint previousVisibilityWords[];
};

layout(push_constant) uniform CullPushConstants {
    uvec4 dispatchParams; // x=maxClustersCapacity (dispatch domain); clusterCount read from SSBO
    vec4 frustumPlanes[6];
    uvec4 visibilityMaskMode;
} pushConstants;

bool AabbOutsideFrustum(const vec3 origin, const vec3 halfExtent)
{
    for (int i = 0; i < 6; ++i) {
        const vec3 absN = abs(pushConstants.frustumPlanes[i].xyz);
        const float r = dot(absN, halfExtent);
        if (dot(pushConstants.frustumPlanes[i].xyz, origin) + pushConstants.frustumPlanes[i].w < -r) {
            return true;
        }
    }
    return false;
}

bool ClusterVisibleInHzb(const uint chunkIndex)
{
    const uint mode = pushConstants.visibilityMaskMode.x;
    if (mode == 2u) {
        return true;
    }
    const uint wordIndex = chunkIndex >> 5u;
    const uint bit = 1u << (chunkIndex & 31u);
    const bool nowVisible = (visibilityWords[wordIndex] & bit) != 0u;
    if (mode == 0u) {
        return nowVisible;
    }
    const bool previouslyVisible = (previousVisibilityWords[wordIndex] & bit) != 0u;
    return !previouslyVisible && nowVisible;
}

void main()
{
    const uint clusterIndex = gl_GlobalInvocationID.x;
    if (clusterIndex >= pushConstants.dispatchParams.x || clusterIndex >= clusterCount) {
        return;
    }

    const FaceCluster cluster = faceClusters[clusterIndex];
    if (cluster.faceCount == 0u) {
        return;
    }

    const vec3 origin = cluster.aabbCenterHalfExtent.xyz;
    const vec3 halfExtent = (length(cluster.aabbHalfExtentXYZ.xyz) > 0.0)
        ? cluster.aabbHalfExtentXYZ.xyz
        : vec3(cluster.aabbCenterHalfExtent.w);
    if (AabbOutsideFrustum(origin, halfExtent)) {
        return;
    }
    if (!ClusterVisibleInHzb(cluster.chunkIndex)) {
        return;
    }

    const uint slot = atomicAdd(groupCountX, 1u);
    visibleClusterIds[slot] = clusterIndex;
    groupCountY = 1u;
    groupCountZ = 1u;
}
