#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

struct ChunkFluidCell {
    uint material;
    uint age;
    uint reserved0;
    uint reserved1;
};

struct ChunkDescriptor {
    ivec4 chunkOrigin;
    uvec4 chunkExtentAndNonAir;
    uvec4 voxelDataInfo;
    uvec4 drawRanges;
};

layout(set = 0, binding = 0, std430) readonly buffer PackedChunkDescriptors {
    ChunkDescriptor chunkDescriptors[];
};

layout(set = 0, binding = 1, std430) readonly buffer ActiveChunkIds {
    uint activeChunkIds[];
};

layout(set = 0, binding = 2, std430) readonly buffer SourceFluidCells {
    ChunkFluidCell sourceCells[];
};

layout(set = 0, binding = 3, std430) writeonly buffer DestinationFluidCells {
    ChunkFluidCell destinationCells[];
};

layout(set = 0, binding = 4, std430) buffer FluidStats {
    uint activeFluidCells;
    uint droppedFluidCells;
    uint iteration;
    uint reserved;
} fluidStats;

layout(push_constant) uniform FluidCaPushConstants {
    uvec4 chunkDimensions;
    uvec4 chunkCountAndFlags;
    float fluidTickInterval;
    uint reserved0;
    uint reserved1;
    uint reserved2;
} pushConstants;

const uint kFluidMaterial = 4u;

bool IsAirOrFluidMaterial(const uint material)
{
    return material == 0u || material == kFluidMaterial;
}

bool IsFluidMaterial(const uint material)
{
    return material == kFluidMaterial;
}

uint GetCellIndex(const uint chunkId, const uint localX, const uint localY, const uint localZ)
{
    return chunkId * (pushConstants.chunkDimensions.x * pushConstants.chunkDimensions.y * pushConstants.chunkDimensions.z)
         + (localZ * pushConstants.chunkDimensions.y + localY) * pushConstants.chunkDimensions.x + localX;
}

void main()
{
    const uint globalIndex = gl_GlobalInvocationID.z * gl_NumWorkGroups.y * gl_NumWorkGroups.x * gl_WorkGroupSize.z * gl_WorkGroupSize.y * gl_WorkGroupSize.x
                           + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.z * gl_WorkGroupSize.y * gl_WorkGroupSize.x
                           + gl_GlobalInvocationID.x;
    if (globalIndex >= pushConstants.chunkCountAndFlags.x) {
        return;
    }

    const uint chunkId = activeChunkIds[globalIndex];
    const ChunkDescriptor chunk = chunkDescriptors[chunkId];
    if (chunk.chunkExtentAndNonAir.y == 0u) {
        return;
    }

    const uint localX = gl_GlobalInvocationID.x;
    const uint localY = gl_GlobalInvocationID.y;
    const uint localZ = gl_GlobalInvocationID.z;
    const uint cellIndex = GetCellIndex(chunkId, localX, localY, localZ);

    const ChunkFluidCell source = sourceCells[cellIndex];
    if (!IsFluidMaterial(source.material)) {
        destinationCells[cellIndex] = source;
        return;
    }

    const int belowIndex = (localZ > 0u)
        ? int(GetCellIndex(chunkId, localX, localY, localZ - 1u))
        : -1;
    if (belowIndex >= 0) {
        const ChunkFluidCell below = sourceCells[belowIndex];
        if (IsAirOrFluidMaterial(below.material)) {
            const uint claimed = atomicOr(destinationCells[belowIndex].material, kFluidMaterial);
            if ((claimed & kFluidMaterial) == 0u) {
                atomicAdd(fluidStats.droppedFluidCells, 1u);
                return;
            }
        }
    }

    destinationCells[cellIndex] = source;
}
