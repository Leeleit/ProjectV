*.hlsl          text eol=lf

# Data / config — LF.
*.json          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.toml          text eol=lf
*.md            text eol=lf
*.markdown      text eol=lf
*.txt           text eol=lf
