#version 450

// TAA resolve for Pipeline B (depth-reproject).
// Motion vector is reconstructed from current depth + previous view-projection.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform image2D inColorCurr;
layout(set = 0, binding = 1, r32f)  uniform image2D inDepthCurr;
layout(set = 0, binding = 2, rgba8) uniform image2D inColorPrev;
layout(set = 0, binding = 3) uniform UboResolve {
    mat4 invViewProjCurr;
    mat4 viewProjPrev;
    vec2 jitterOffset;
    vec2 resolution;
    float blendFactor;
    uint frameIndex;
} ubo;

layout(set = 0, binding = 4, rgba8) uniform image2D outColor;

vec3 rgb2yCoCg(vec3 c) {
    return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
                0.5 * c.r - 0.5 * c.b,
                -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

vec3 yCoCg2rgb(vec3 c) {
    return vec3(c.x + c.y - c.z,
                c.x + c.z,
                c.x - c.y - c.z);
}

vec2 reconstructMotion(ivec2 pixel, vec2 jitterOffset) {
    // Read current depth
    float depth = imageLoad(inDepthCurr, pixel).r;
    if (depth >= 1.0) return vec2(0.0);  // skybox / cleared depth

    // Reconstruct NDC
    vec2 ndc = (vec2(pixel) + 0.5) / ubo.resolution * 2.0 - 1.0;
    ndc += jitterOffset;  // account for current frame jitter
    vec4 clip = vec4(ndc, depth, 1.0);

    // Unproject to world space using inv viewProj
    vec4 world = ubo.invViewProjCurr * clip;
    world.xyz /= world.w;

    // Reproject to previous clip space
    vec4 prevClip = ubo.viewProjPrev * world;
    vec2 prevNDC = prevClip.xy / prevClip.w;
    vec2 currNDC = clip.xy / clip.w;
    return (prevNDC - currNDC) * 0.5;  // delta in NDC space
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(ubo.resolution.x) || pixel.y >= int(ubo.resolution.y)) return;

    vec2 uv = (vec2(pixel) + 0.5) / ubo.resolution + ubo.jitterOffset;
    vec3 currColor = imageLoad(inColorCurr, pixel).rgb;
    vec2 motion = reconstructMotion(pixel, ubo.jitterOffset);

    // Reproject
    vec2 prevUV = uv + motion;
    vec3 history = vec3(0.0);
    if (prevUV.x >= 0.0 && prevUV.x <= 1.0 && prevUV.y >= 0.0 && prevUV.y <= 1.0) {
        ivec2 prevPixel = ivec2(prevUV * ubo.resolution);
        history = imageLoad(inColorPrev, prevPixel).rgb;
    }

    // Karis 2014 neighborhood clamping
    vec3 currYCoCg = rgb2yCoCg(currColor);
    vec3 histYCoCg = rgb2yCoCg(history);

    vec3 minAABB = currYCoCg;
    vec3 maxAABB = currYCoCg;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 p = pixel + ivec2(dx, dy);
            if (p.x < 0 || p.x >= int(ubo.resolution.x) || p.y < 0 || p.y >= int(ubo.resolution.y)) continue;
            vec3 n = imageLoad(inColorCurr, p).rgb;
            vec3 nyCoCg = rgb2yCoCg(n);
            minAABB = min(minAABB, nyCoCg);
            maxAABB = max(maxAABB, nyCoCg);
        }
    }
    histYCoCg = clamp(histYCoCg, minAABB, maxAABB);
    vec3 outYCoCg = mix(currYCoCg, histYCoCg, ubo.blendFactor);
    vec3 outRGB = yCoCg2rgb(outYCoCg);

    imageStore(outColor, pixel, vec4(outRGB, 1.0));
}
