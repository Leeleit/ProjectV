+bool RayTracedShadows::CreateRtxVisiblePixelsPipeline(const VulkanContextState &context)
+{
+	DestroyRtxVisiblePixelsPipeline(context);
+	const VkDevice device = context.device;
+	if (device == VK_NULL_HANDLE) {
+		return false;
+	}
+
+	std::array bindings = {
+		VkDescriptorSetLayoutBinding{
+			.binding = 0,
+			.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,
+			.descriptorCount = 1u,
+			.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+			.pImmutableSamplers = nullptr},
+		VkDescriptorSetLayoutBinding{
+			.binding = 1,
+			.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLER,
+			.descriptorCount = 1u,
+			.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+			.pImmutableSamplers = nullptr},
+		VkDescriptorSetLayoutBinding{
+			.binding = 2,
+			.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+			.descriptorCount = 1u,
+			.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+			.pImmutableSamplers = nullptr},
+		VkDescriptorSetLayoutBinding{
+			.binding = 3,
+			.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+			.descriptorCount = 1u,
+			.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+			.pImmutableSamplers = nullptr},
+		VkDescriptorSetLayoutBinding{
+			.binding = 4,
+			.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+			.descriptorCount = 1u,
+			.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+			.pImmutableSamplers = nullptr}};
+
+	VkDescriptorSetLayoutCreateInfo layoutInfo{};
+	layoutInfo.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
+	layoutInfo.bindingCount = static_cast<uint32_t>(bindings.size());
+	layoutInfo.pBindings = bindings.data();
+	if (vkCreateDescriptorSetLayout(device, &layoutInfo, nullptr, &m_rtxVisiblePixelsDescriptorSetLayout) != VK_SUCCESS) {
+		runtime::LogRuntimeFailure("Render", "CreateRtxVisiblePixelsPipeline.setLayout", "vkCreateDescriptorSetLayout failed");
+		DestroyRtxVisiblePixelsPipeline(context);
+		return false;
+	}
+
+	VkPushConstantRange pushConstantRange{};
+	pushConstantRange.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+	pushConstantRange.offset = 0u;
+	pushConstantRange.size = sizeof(uint32_t) * 4u; // uvec2 shadowMaskExtent + uvec2 hizExtent
+
+	VkPipelineLayoutCreateInfo pipelineLayoutInfo{};
+	pipelineLayoutInfo.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+	pipelineLayoutInfo.setLayoutCount = 1u;
+	pipelineLayoutInfo.pSetLayouts = &m_rtxVisiblePixelsDescriptorSetLayout;
+	pipelineLayoutInfo.pushConstantRangeCount = 1u;
+	pipelineLayoutInfo.pPushConstantRanges = &pushConstantRange;
+	if (vkCreatePipelineLayout(device, &pipelineLayoutInfo, nullptr, &m_rtxVisiblePixelsPipelineLayout) != VK_SUCCESS) {
+		runtime::LogRuntimeFailure("Render", "CreateRtxVisiblePixelsPipeline.pipelineLayout", "vkCreatePipelineLayout failed");
+		DestroyRtxVisiblePixelsPipeline(context);
+		return false;
+	}
+
+	const std::vector<char> shaderCode = ReadShaderFile("rtx_visible_pixels.comp.spv");
+	if (shaderCode.empty()) {
+		runtime::LogRuntimeFailure("Render", "CreateRtxVisiblePixelsPipeline.shaderFile", "rtx_visible_pixels.comp.spv not found");
+		DestroyRtxVisiblePixelsPipeline(context);
+		return false;
+	}
+
+	VkShaderModuleCreateInfo moduleInfo{};
+	moduleInfo.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+	moduleInfo.codeSize = shaderCode.size();
+	moduleInfo.pCode = reinterpret_cast<const uint32_t *>(shaderCode.data());
+	if (vkCreateShaderModule(device, &moduleInfo, nullptr, &m_rtxVisiblePixelsShaderModule) != VK_SUCCESS) {
+		runtime::LogRuntimeFailure("Render", "CreateRtxVisiblePixelsPipeline.shaderModule", "vkCreateShaderModule failed");
+		DestroyRtxVisiblePixelsPipeline(context);
+		return false;
+	}
+
+	VkComputePipelineCreateInfo pipelineInfo{};
+	pipelineInfo.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO;
+	pipelineInfo.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+	pipelineInfo.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+	pipelineInfo.stage.module = m_rtxVisiblePixelsShaderModule;
+	pipelineInfo.stage.pName = "main";
+	pipelineInfo.layout = m_rtxVisiblePixelsPipelineLayout;
+	if (vkCreateComputePipelines(device, context.pipelineCache, 1u, &pipelineInfo, nullptr, &m_rtxVisiblePixelsPipeline) != VK_SUCCESS) {
+		runtime::LogRuntimeFailure("Render", "CreateRtxVisiblePixelsPipeline.pipeline", "vkCreateComputePipelines failed");
+		DestroyRtxVisiblePixelsPipeline(context);
+		return false;
+	}
+
+	std::array poolSizes = {
+		VkDescriptorPoolSize{VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 1u},
+		VkDescriptorPoolSize{VK_DESCRIPTOR_TYPE_SAMPLER, 1u},
+		VkDescriptorPoolSize{VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 3u}};
+	VkDescriptorPoolCreateInfo poolInfo{};
+	poolInfo.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+	poolInfo.maxSets = 1u;
+	poolInfo.poolSizeCount = static_cast<uint32_t>(poolSizes.size());
+	poolInfo.pPoolSizes = poolSizes.data();
+	if (vkCreateDescriptorPool(device, &poolInfo, nullptr, &m_rtxVisiblePixelsDescriptorPool) != VK_SUCCESS) {
+		runtime::LogRuntimeFailure("Render", "CreateRtxVisiblePixelsPipeline.descriptorPool", "vkCreateDescriptorPool failed");
+		DestroyRtxVisiblePixelsPipeline(context);
+		return false;
+	}
+
+	VkDescriptorSetAllocateInfo allocInfo{};
+	allocInfo.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+	allocInfo.descriptorPool = m_rtxVisiblePixelsDescriptorPool;
+	allocInfo.descriptorSetCount = 1u;
+	allocInfo.pSetLayouts = &m_rtxVisiblePixelsDescriptorSetLayout;
+	if (vkAllocateDescriptorSets(device, &allocInfo, &m_rtxVisiblePixelsDescriptorSet) != VK_SUCCESS) {
+		runtime::LogRuntimeFailure("Render", "CreateRtxVisiblePixelsPipeline.allocateSets", "vkAllocateDescriptorSets failed");
+		DestroyRtxVisiblePixelsPipeline(context);
+		return false;
+	}
+	return true;
+}
+
+void RayTracedShadows::DestroyRtxVisiblePixelsPipeline(const VulkanContextState &context) noexcept
+{
+	const VkDevice device = context.device;
+	if (device == VK_NULL_HANDLE) {
+		m_rtxVisiblePixelsPipeline = VK_NULL_HANDLE;
+		m_rtxVisiblePixelsPipelineLayout = VK_NULL_HANDLE;
+		m_rtxVisiblePixelsDescriptorSetLayout = VK_NULL_HANDLE;
+		m_rtxVisiblePixelsDescriptorPool = VK_NULL_HANDLE;
+		m_rtxVisiblePixelsDescriptorSet = VK_NULL_HANDLE;
+		m_rtxVisiblePixelsShaderModule = VK_NULL_HANDLE;
+		return;
+	}
+	if (m_rtxVisiblePixelsPipeline != VK_NULL_HANDLE) {
+		vkDestroyPipeline(device, m_rtxVisiblePixelsPipeline, nullptr);
+		m_rtxVisiblePixelsPipeline = VK_NULL_HANDLE;
+	}
+	if (m_rtxVisiblePixelsPipelineLayout != VK_NULL_HANDLE) {
+		vkDestroyPipelineLayout(device, m_rtxVisiblePixelsPipelineLayout, nullptr);
+		m_rtxVisiblePixelsPipelineLayout = VK_NULL_HANDLE;
+	}
+	if (m_rtxVisiblePixelsDescriptorPool != VK_NULL_HANDLE) {
+		vkDestroyDescriptorPool(device, m_rtxVisiblePixelsDescriptorPool, nullptr);
+		m_rtxVisiblePixelsDescriptorPool = VK_NULL_HANDLE;
+	}
+	m_rtxVisiblePixelsDescriptorSet = VK_NULL_HANDLE;
+	if (m_rtxVisiblePixelsDescriptorSetLayout != VK_NULL_HANDLE) {
+		vkDestroyDescriptorSetLayout(device, m_rtxVisiblePixelsDescriptorSetLayout, nullptr);
+		m_rtxVisiblePixelsDescriptorSetLayout = VK_NULL_HANDLE;
+	}
+	if (m_rtxVisiblePixelsShaderModule != VK_NULL_HANDLE) {
+		vkDestroyShaderModule(device, m_rtxVisiblePixelsShaderModule, nullptr);
+		m_rtxVisiblePixelsShaderModule = VK_NULL_HANDLE;
+	}
+}
