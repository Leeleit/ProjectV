+size_t GetVoxelFluidFillFlatIndex(const VoxelWorld &world, const Int3 position)
+{
+	const size_t localX = static_cast<size_t>(position.x - world.min.x);
+	const size_t localY = static_cast<size_t>(position.y - world.min.y);
+	const size_t localZ = static_cast<size_t>(position.z - world.min.z);
+	return localX + static_cast<size_t>(world.width) * (localY + static_cast<size_t>(world.height) * localZ);
+}
+
+uint8_t GetVoxelFluidFill(const VoxelWorld &world, const Int3 position)
+{
+	if (!IsInsideVoxelWorld(world, position) || world.fluidFill.empty()) {
+		return kVoxelFluidFillEmpty;
+	}
+	return world.fluidFill[GetVoxelFluidFillFlatIndex(world, position)];
+}
+
+void SetVoxelFluidFill(VoxelWorld &world, const Int3 position, const uint8_t fill)
+{
+	if (!IsInsideVoxelWorld(world, position)) {
+		return;
+	}
+	if (world.fluidFill.empty()) {
+		world.fluidFill.assign(static_cast<size_t>(world.width) * static_cast<size_t>(world.height) * static_cast<size_t>(world.depth), kVoxelFluidFillEmpty);
+	}
+	world.fluidFill[GetVoxelFluidFillFlatIndex(world, position)] = fill;
+}
