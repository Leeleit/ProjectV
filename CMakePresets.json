{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_C_STANDARD_REQUIRED": "ON",
        "CMAKE_C_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-clang-debug",
      "displayName": "Windows Clang Debug",
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": "OFF",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "CMAKE_LINKER_TYPE": "LLD",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ]
        }
      }
    },
    {
      "name": "windows-clang-debug-tracy-profiler",
      "displayName": "Windows Clang Debug + Tracy Profiler",
      "inherits": "windows-clang-debug",
      "cacheVariables": {
        "PROJECTV_ENABLE_TRACY": "ON",
        "PROJECTV_BUILD_TRACY_PROFILER": "ON",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "CMAKE_DISABLE_FIND_PACKAGE_rocprofiler-sdk": "TRUE",
        "CPM_SOURCE_CACHE": "",
        "NO_ISA_EXTENSIONS": "ON",
        "BASE64_WERROR": "OFF",
        "BUILD_LIBCURL_DOCS": "OFF",
        "BUILD_MISC_DOCS": "OFF",
        "ENABLE_CURL_MANUAL": "OFF",
        "CMAKE_MESSAGE_LOG_LEVEL": "NOTICE",
        "CMAKE_WARN_DEPRECATED": "OFF",
        "CMAKE_SUPPRESS_DEVELOPER_WARNINGS": "TRUE",
        "CMAKE_POLICY_DEFAULT_CMP0069": "NEW",
        "CMAKE_C_FLAGS": "/clang:-Wno-unused-command-line-argument /D_CRT_SECURE_NO_WARNINGS /D_CRT_NONSTDC_NO_WARNINGS",
        "CMAKE_CXX_FLAGS": "/clang:-Wno-unused-command-line-argument /EHsc /D_CRT_SECURE_NO_WARNINGS /D_CRT_NONSTDC_NO_WARNINGS"
      }
    }
  ]
}
